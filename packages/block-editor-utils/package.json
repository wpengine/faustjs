{
	"name": "@faustwp/block-editor-utils",
	"version": "0.3.9",
	"description": "Faust Block Editor Utils Package",
	"main": "dist/cjs/index.js",
	"module": "dist/mjs/index.js",
	"types": "dist/mjs/index.d.ts",
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"dependencies": {
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/hooks": "^4.56.0",
		"@wordpress/i18n": "^6.29.0"
	},
	"devDependencies": {
		"@react-spring/web": "9.7.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^29.5.5",
		"@types/node": "^18.0.6",
		"@types/react": "^18.2.28",
		"@types/wordpress__block-editor": "11.5.5",
		"@types/wordpress__blocks": "12.5.6",
		"@wordpress/jest-preset-default": "^11.14.0",
		"jest": "29.7.0",
		"jest-environment-jsdom": "29.7.0",
		"rimraf": "^6.1.3",
		"ts-jest": "29.4.14"
	},
	"scripts": {
		"prebuild": "npm run clean",
		"postbuild": "npm run package",
		"clean": "rimraf dist",
		"package": "node ../../scripts/package.js",
